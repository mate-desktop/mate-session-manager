#: capplet/main.c:80
msgid "- MATE Session Properties"
msgstr "- ຄຸນສົມບັດຂອງເຊດຊັນ MATE"

#: data/org.mate.session.gschema.xml.in:5
msgid "Current session start time"
msgstr "ເວລາເລີ່ມຕົ້ນຂອງເຊດຊັນປັດຈຸບັນ"

#: data/org.mate.session.gschema.xml.in:6
msgid "Unix time of the start of the current session."
msgstr "ເວລາ Unix ທີ່ເລີ່ມຕົ້ນເຊດຊັນປັດຈຸບັນ."

#: data/org.mate.session.gschema.xml.in:10
msgid "Save sessions"
msgstr "ບັນທຶກເຊດຊັນ"

#: data/org.mate.session.gschema.xml.in:11
msgid "If enabled, mate-session will save the session automatically."
msgstr "ຖ້າເປີດໃຊ້, mate-session ຈະບັນທຶກເຊດຊັນໂດຍອັດຕະໂນມັດ."

#: data/org.mate.session.gschema.xml.in:15
msgid "Show hidden autostart applications"
msgstr "ສະແດງແອັບພລິເຄຊັນເລີ່ມຕົ້ນອັດຕະໂນມັດທີ່ຖືກເຊື່ອງໄວ້"

#: data/org.mate.session.gschema.xml.in:16
msgid ""
"If enabled, mate-session-properties will show hidden autostart applications."
msgstr ""
"ຖ້າເປີດໃຊ້, mate-session-properties ຈະສະແດງແອັບພລິເຄຊັນເລີ່ມຕົ້ນທີ່ຖືກເຊື່ອງໄວ້."

#: data/org.mate.session.gschema.xml.in:20
msgid "Logout prompt"
msgstr "ຖາມກ່ອນອອກຈາກລະບົບ"

#: data/org.mate.session.gschema.xml.in:21
msgid "If enabled, mate-session will prompt the user before ending a session."
msgstr "ຖ້າເປີດໃຊ້, mate-session ຈະຖາມຜູ້ໃຊ້ກ່ອນທີ່ຈະສິ້ນສຸດເຊດຊັນ."

#: data/org.mate.session.gschema.xml.in:26
msgid "Logout timeout"
msgstr "ເວລາສິ້ນສຸດການອອກຈາກລະບົບ"

#: data/org.mate.session.gschema.xml.in:27
msgid ""
"If logout prompt is enabled, this set the timeout in seconds before logout "
"automatically. If 0, automatic logout is disabled."
msgstr ""
"ຖ້າເປີດການຖາມກ່ອນອອກຈາກລະບົບ, ນີ້ຈະກຳນົດເວລາເປັນວິນາທີກ່ອນທີ່ຈະອອກຈາກລະບົບໂດຍອັດຕະໂນມັດ. ຖ້າເປັ"
"ນ 0, ການອອກຈາກລະບົບອັດຕະໂນມັດຈະຖືກປິດໃຊ້ງານ."

#: data/org.mate.session.gschema.xml.in:31
msgid "Time before session is considered idle"
msgstr "ເວລາກ່ອນທີ່ເຊດຊັນຈະຖືກຖືວ່າວ່າງ (idle)"

#: data/org.mate.session.gschema.xml.in:32
msgid ""
"The number of minutes of inactivity before the session is considered idle."
msgstr "ຈຳນວນນາທີທີ່ບໍ່ມີການເຄື່ອນໄຫວກ່ອນທີ່ເຊດຊັນຈະຖືກຖືວ່າວ່າງ."

#: data/org.mate.session.gschema.xml.in:36
msgid "Default session"
msgstr "ເຊດຊັນເລີ່ມຕົ້ນ"

#: data/org.mate.session.gschema.xml.in:37
msgid "List of applications that are part of the default session."
msgstr "ລາຍຊື່ແອັບພລິເຄຊັນທີ່ເປັນສ່ວນໜຶ່ງຂອງເຊດຊັນເລີ່ມຕົ້ນ."

#: data/org.mate.session.gschema.xml.in:41
msgid "Required session components"
msgstr "ອົງປະກອບທີ່ຈຳເປັນຂອງເຊດຊັນ"

#: data/org.mate.session.gschema.xml.in:42
msgid ""
"List of components that are required as part of the session. (Each element "
"names a key under \"/org/mate/desktop/session/required_components\"). The "
"Startup Applications preferences tool will not normally allow users to "
"remove a required component from the session, and the session manager will "
"automatically add the required components back to the session at login time "
"if they do get removed."
msgstr ""
"ລາຍຊື່ອົງປະກອບທີ່ຈຳເປັນເຊິ່ງເປັນສ່ວນໜຶ່ງຂອງເຊດຊັນ. ໂດຍປົກກະຕິແລ້ວເຄື່ອງມືຕັ້ງຄ່າແອັບພລິເຄຊັນເລີ່ມຕົ້ນຈະບໍ່ອະ"
"ນຸຍາດໃຫ້ຜູ້ໃຊ້ເອົາອົງປະກອບທີ່ຈຳເປັນອອກຈາກເຊດຊັນ, ແລະ ຕົວຈັດການເຊດຊັນຈະເພີ່ມອົງປະກອບທີ່ຈຳເປັນກັບຄືນເ"
"ຂົ້າໃນເຊດຊັນໂດຍອັດຕະໂນມັດໃນເວລາເຂົ້າສູ່ລະບົບ ຫາກພວກມັນຖືກເອົາອອກ."

#: data/org.mate.session.gschema.xml.in:46
msgid "Control gnome compatibility component startup"
msgstr "ຄວບຄຸມການເລີ່ມຕົ້ນຂອງອົງປະກອບທີ່ເຂົ້າກັນໄດ້ກັບ gnome"

#: data/org.mate.session.gschema.xml.in:47
msgid "Control which compatibility components to start."
msgstr "ຄວບຄຸມວ່າຈະເລີ່ມຕົ້ນອົງປະກອບທີ່ເຂົ້າກັນໄດ້ໃດແດ່."

#: data/org.mate.session.gschema.xml.in:54 data/mate-wm.desktop.in:4
msgid "Window Manager"
msgstr "ຕົວຈັດການໜ້າຕ່າງ"

#: data/org.mate.session.gschema.xml.in:55
msgid ""
"The window manager is the program that draws the title bar and borders "
"around windows, and allows you to move and resize windows."
msgstr ""
"ຕົວຈັດການໜ້າຕ່າງແມ່ນໂປຣແກຣມທີ່ແຕ້ມແຖບຊື່ ແລະ ຂອບອ້ອມຮອບໜ້າຕ່າງ, ແລະ ຊ່ວຍໃຫ້ເຈົ້າຍ້າຍ ຫຼື ປ່ຽນຂະໜາດ"
"ໜ້າຕ່າງໄດ້."

#: data/org.mate.session.gschema.xml.in:59
msgid "Panel"
msgstr "ພາເນລ"

#: data/org.mate.session.gschema.xml.in:60
msgid ""
"The panel provides the bar at the top or bottom of the screen containing "
"menus, the window list, status icons, the clock, etc."
msgstr ""
"ພາເນລແມ່ນແຖບທີ່ຢູ່ທາງເທິງ ຫຼື ທາງລຸ່ມຂອງໜ້າຈໍ ທີ່ປະກອບມີເມນູ, ລາຍຊື່ໜ້າຕ່າງ, ໄອຄອນສະຖານະ, ໂມງ ແລ"
"ະ ອື່ນໆ."

#: data/org.mate.session.gschema.xml.in:64
msgid "File Manager"
msgstr "ຕົວຈັດການໄຟລ໌"

#: data/org.mate.session.gschema.xml.in:65
msgid ""
"The file manager provides the desktop icons and allows you to interact with "
"your saved files."
msgstr ""
"ຕົວຈັດການໄຟລ໌ໃຫ້ບໍລິການໄອຄອນໜ້າຈໍ ແລະ ຊ່ວຍໃຫ້ເຈົ້າຈັດການກັບໄຟລ໌ທີ່ບັນທຶກໄວ້."

#: data/org.mate.session.gschema.xml.in:69
msgid "Dock"
msgstr "ດັອກ"

#: data/org.mate.session.gschema.xml.in:70
msgid ""
"A dock provides a dockable area, similar to a panel, for launching and "
"switching applications."
msgstr ""
"ດັອກແມ່ນພື້ນທີ່ສຳລັບວາງໄອຄອນ, ຄ້າຍຄືກັບພາເນລ, ເພື່ອໃຊ້ເປີດ ແລະ ສະຫຼັບແອັບພລິເຄຊັນ."

#: data/mate.desktop.in:3
msgid "MATE"
msgstr "MATE"

#: data/mate.desktop.in:4
msgid "This session logs you into MATE"
msgstr "ເຊດຊັນນີ້ຈະນຳເຈົ້າເຂົ້າສູ່ລະບົບ MATE"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: data/mate.desktop.in:11
msgid "launch;MATE;desktop;session;"
msgstr "launch;MATE;desktop;session;ເປີດ;ເດັສທັອບ;ເຊດຊັນ;"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: data/mate-wm.desktop.in:7
msgid "MATE;window;manager;launch;MDM;"
msgstr "MATE;window;manager;launch;MDM;ໜ້າຕ່າງ;ຕົວຈັດການ;"

#: data/gsm-inhibit-dialog.ui:14
msgid "<b>Some programs are still running:</b>"
msgstr "<b>ບາງໂປຣແກຣມຍັງເຮັດວຽກຢູ່:</b>"

#: data/gsm-inhibit-dialog.ui:52 mate-session/gsm-inhibit-dialog.c:643
msgid ""
"Waiting for the program to finish.  Interrupting the program may cause you "
"to lose work."
msgstr ""
"ກຳລັງລໍຖ້າໃຫ້ໂປຣແກຣມເຮັດວຽກໃຫ້ແລ້ວ. ການຂັດຈັງຫວະໂປຣແກຣມອາດເຮັດໃຫ້ວຽກຂອງເຈົ້າເສຍຫາຍໄດ້."

#: data/mate-session-properties.desktop.in:3
msgid "Startup Applications"
msgstr "ແອັບພລິເຄຊັນເລີ່ມຕົ້ນ"

#: data/mate-session-properties.desktop.in:4
msgid "Choose what applications to start when you log in"
msgstr "ເລືອກແອັບພລິເຄຊັນທີ່ຈະເລີ່ມຕົ້ນເມື່ອເຈົ້າເຂົ້າສູ່ລະບົບ"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: data/mate-session-properties.desktop.in:13
msgid "MATE;session;properties;applications;login;start;"
msgstr "MATE;session;properties;applications;login;start;ຄຸນສົມບັດ;ແອັບ;ເລີ່ມ;"

#: data/session-properties.ui:35
msgid "Additional startup _programs:"
msgstr "_ໂປຣແກຣມເລີ່ມຕົ້ນເພີ່ມເຕີມ:"

#: data/session-properties.ui:86
msgid "_Custom Add"
msgstr "ເພີ່ມແບບ_ກຳນົດເອງ"

#: data/session-properties.ui:116
msgid "_Remove"
msgstr "_ເອົາອອກ"

#: data/session-properties.ui:132
msgid "_Edit"
msgstr "_ແກ້ໄຂ"

#: data/session-properties.ui:162
msgid "_Show hidden"
msgstr "_ສະແດງອັນທີ່ເຊື່ອງໄວ້"

#: data/session-properties.ui:183
msgid "Startup Programs"
msgstr "ໂປຣແກຣມເລີ່ມຕົ້ນ"

#: data/session-properties.ui:198
msgid "_Automatically remember running applications when logging out"
msgstr "ຈົດຈຳແອັບພລິເຄຊັນທີ່ກຳລັງເຮັດວຽກໂດຍ_ອັດຕະໂນມັດເມື່ອອອກຈາກລະບົບ"

#: data/session-properties.ui:240
msgid "_Remember Currently Running Application"
msgstr "_ຈົດຈຳແອັບພລິເຄຊັນທີ່ກຳລັງເຮັດວຽກຢູ່ປັດຈຸບັນ"

